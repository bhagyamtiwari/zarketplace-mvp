{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/item/:sku",
      "destination": "/api/item?sku=:sku"
    },
    {
      "source": "/browse",
      "destination": "/api/page?path=/browse"
    },
    {
      "source": "/sell",
      "destination": "/api/page?path=/sell"
    },
    {
      "source": "/buyer-protection",
      "destination": "/api/page?path=/buyer-protection"
    },
    {
      "source": "/shipping-policy",
      "destination": "/api/page?path=/shipping-policy"
    },
    {
      "source": "/vendor-policy",
      "destination": "/api/page?path=/vendor-policy"
    },
    {
      "source": "/about",
      "destination": "/api/page?path=/about"
    },
    {
      "source": "/faq",
      "destination": "/api/page?path=/faq"
    },
    {
      "source": "/conditions-guide",
      "destination": "/api/page?path=/conditions-guide"
    },
    {
      "source": "/returns",
      "destination": "/api/page?path=/returns"
    },
    {
      "source": "/refund-policy",
      "destination": "/api/page?path=/refund-policy"
    },
    {
      "source": "/terms",
      "destination": "/api/page?path=/terms"
    },
    {
      "source": "/privacy",
      "destination": "/api/page?path=/privacy"
    },
    {
      "source": "/contact",
      "destination": "/api/page?path=/contact"
    },
    {
      "source": "/grievance-officer",
      "destination": "/api/page?path=/grievance-officer"
    },
    {
      "source": "/trademark-notice",
      "destination": "/api/page?path=/trademark-notice"
    },
    {
      "source": "/((?!api/|assets/|images/|favicon\\.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://us-assets.i.posthog.com; frame-src https://*.razorpay.com https://checkout.razorpay.com; connect-src 'self' https://*.supabase.co https://*.razorpay.com https://lumberjack.razorpay.com https://*.vercel-insights.com https://vitals.vercel-insights.com https://us.i.posthog.com https://us-assets.i.posthog.com; img-src 'self' data: blob: https://*.supabase.co https://*.razorpay.com https://images.unsplash.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}